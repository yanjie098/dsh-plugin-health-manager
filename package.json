{
  "name": "dsh-plugin-health-manager",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: 多成员健康管理（体检报告导入、历史健康数据、日常记录、基于长寿管理框架的 AI 风险与建议）",
  "license": "MIT",
  "author": "yanjie098",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanjie098/dsh-plugin-health-manager.git"
  },
  "homepage": "https://github.com/yanjie098/dsh-plugin-health-manager#readme",
  "bugs": {
    "url": "https://github.com/yanjie098/dsh-plugin-health-manager/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "health",
    "health-management",
    "longevity",
    "体检",
    "健康管理"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
